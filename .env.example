# Elite Marry Me — Sales Call Intelligence Platform
# Copy this file to .env.local and fill in what you have. The app runs fully in
# DEMO MODE with seeded data when any of these are left blank — nothing below is
# required to run `npm run dev` and explore the product.

# --- Supabase (persistence + auth) ---
# Without these, the app uses seeded in-memory demo data instead of Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the client. Required for the analysis pipeline
# and webhooks to write to Postgres.
SUPABASE_SERVICE_ROLE_KEY=

# --- Quo (formerly OpenPhone) ---
# Without this, call/transcript sync is disabled; use the manual call entry flow instead.
QUO_API_KEY=
QUO_API_BASE_URL=https://api.quo.com

# --- HubSpot CRM (read-only in this MVP) ---
# Without this, CRM matching is disabled; use the manual contact/deal fields instead.
HUBSPOT_ACCESS_TOKEN=

# --- Anthropic (Claude) ---
# Without this, call analysis falls back to a deterministic demo heuristic instead
# of real AI scoring.
ANTHROPIC_API_KEY=

# --- App ---
APP_URL=http://localhost:3000

# --- Webhooks ---
# Shared secret used to verify inbound Quo webhook signatures (HMAC-SHA256 over the
# raw request body). Leave blank in local/demo use; required in production.
WEBHOOK_SECRET=
