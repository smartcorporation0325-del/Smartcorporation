# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.

# --- Claude (https://platform.claude.com) ---
ANTHROPIC_API_KEY=
# Modelo y esfuerzo. Para bajar costos puedes probar claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que tú inventas; lo pones igual en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configuración de la app → Básica); sirve para verificar que los webhooks vienen de Meta
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
# Plantilla aprobada con un parámetro {{1}} para escribir pasadas 24 h sin mensajes de la persona (opcional)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# --- Transcripción de audios (opcional; cualquier servicio compatible con /audio/transcriptions) ---
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Supabase (sin esto, los datos viven en memoria y se borran al reiniciar) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mensajes proactivos ---
# Secreto para llamar POST /cron/tick (cabecera Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# true = el propio servidor revisa cada 5 min (útil si tu hosting no tiene cron)
INTERNAL_CRON=false
DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_MORNING_TIME=08:30
DEFAULT_EVENING_TIME=21:00

# Política de privacidad pública en /privacy (Meta la pide para publicar la app)
PRIVACY_OPERATOR=Ancla
PRIVACY_CONTACT_EMAIL=

PORT=3000
